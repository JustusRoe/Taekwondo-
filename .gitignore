# Zugangsdaten des Servers – niemals ins Repository
backend/config.php

# Private Videoablage (liegt im Echtbetrieb außerhalb des Web-Ordners)
videos-privat/

# Rohaufnahmen vom Handy. Der Ordner selbst gehört mit LIESMICH.md und
# reihenfolge.txt ins Repository, die Aufnahmen darin nicht.
videos-roh/*
!videos-roh/LIESMICH.md
!videos-roh/reihenfolge.txt

# Systemdateien
.DS_Store
Thumbs.db

# Lokale Testumgebung (wird von test/testmain.sh erzeugt)
test/daten/
test/videos-privat/
test/daten/postausgang/

# Die aufbereiteten Trainingsvideos und ihre Vorschaubilder waren hier
# ausgeschlossen, weil darauf Mitglieder zu erkennen sind. Seit die
# Rohaufnahmen bewusst im Repository liegen (Commit a9dcd7c) schuetzt der
# Ausschluss nichts mehr – er wuerde nur die Videothek der Vorschau auf
# GitHub Pages leer laufen lassen, denn der Entwurfsbereich laedt seine
# Dateien aus assets/video/. Deshalb sind sie jetzt eingecheckt.
